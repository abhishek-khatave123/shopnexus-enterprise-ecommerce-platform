# Database
DATABASE_URL=postgresql://shopnexus:shopnexus@localhost:5432/shopnexus

# JWT
# Set a strong secret in backend/.env for local development and production; never commit a real secret.
JWT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Razorpay (leave blank to disable payments; app will run fine without these)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary (leave blank to disable image upload; app will run fine without these)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (leave blank to disable email sending; events will be logged instead)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@shopnexus.com

# Misc
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
